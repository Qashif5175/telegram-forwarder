{
  // Committed so that saving a file in this repository does the same thing for
  // everybody, and the same thing `just fmt` and `just lint` do. Nothing here
  // is a preference — it is the project's own checks, moved earlier.

  // `rustfmt`, through the extension that ships it. `just fmt` runs
  // `cargo fmt --all --check`, so formatting on save is that check, passed
  // before it is ever run.
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },

  // The editor should fail on exactly what CI fails on. Without these,
  // rust-analyzer runs plain `cargo check`, which is quieter than `just lint`
  // in both directions: no pedantic lints, and nothing from tests.
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--all-targets"],

  // The prose in README.md and AGENTS.md is wrapped by hand at 80 columns.
  // Every Markdown formatter reflows it, which rewrites both files entirely and
  // produces a diff nothing in CI can check. Off here rather than left to
  // whatever each person has set globally.
  "[markdown]": {
    "editor.formatOnSave": false
  },

  // `taplo`, through the extension that embeds it. The rules it follows are in
  // `.taplo.toml` rather than here, so the same formatting applies to anyone
  // running `taplo` directly and does not depend on per-editor defaults.
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },

  // Key and array order carries meaning in `deny.toml` and `dist-workspace.toml`
  // — see `.taplo.toml`. This extension can reorder independently of the rules
  // in that file, so it is turned off here as well.
  "evenBetterToml.formatter.reorderKeys": false,
  "evenBetterToml.formatter.reorderArrays": false
}
