{
  // Naming a formatter in settings.json only works if it is installed;
  // otherwise saving quietly does nothing. This is the prompt that gets it
  // installed, and it is a recommendation rather than a requirement — the
  // command line is `just check`, and nothing here is needed to run it.
  // One entry per formatter named in settings.json, and no more. Every
  // recommendation is a prompt somebody has to answer, so a list that grows
  // past what the project actually relies on stops being read.
  "recommendations": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
}
